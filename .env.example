# Copy to .env and edit. NEVER commit the real .env file.
APP_ENV=development

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_MINUTES=60

# MySQL (matches docker-compose.yml)
DATABASE_URL=mysql+pymysql://pawtrack:pawtrack@127.0.0.1:3306/pawtrack

# Caching: none | memory | redis
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=60
